{
  "name": "paytriva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "notifications:worker": "tsx --conditions=react-server scripts/notification-worker.ts",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "tsx --conditions=react-server scripts/demo-seed.ts",
    "db:demo:clear": "tsx --conditions=react-server scripts/demo-seed.ts --clear",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "tsx --conditions=react-server --test --test-concurrency=1 \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
