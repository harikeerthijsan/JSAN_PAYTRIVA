DATABASE_URL="postgresql://postgres:password@localhost:5432/paytriva?schema=public"
APP_URL="http://localhost:3000"
SESSION_DURATION_DAYS="7"
INVITATION_EXPIRY_HOURS="72"
PASSWORD_RESET_EXPIRY_MINUTES="30"
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="PAYTRIVA Administrator"

# Optional. Without SMTP, one-time links are returned to authorized staff only
# in development. Production requires SMTP before creating invitations/resets.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Required only when SMTP credentials are saved in PAYTRIVA's admin settings.
# Use a persistent random secret (at least 32 characters) and keep it outside source control.
NOTIFICATION_SECRETS_KEY=""

# Optional domain restriction, e.g. jsanconsulting.com. No domain is assumed.
ALLOWED_EMAIL_DOMAIN=""

# Private payment-document storage. Keep this outside public/static directories.
# Optional absolute path; defaults to the ignored .private-uploads folder.
PAYTRIVA_UPLOAD_DIR=""
PAYMENT_MAX_FILE_BYTES="20971520"
PAYMENT_MAX_TOTAL_UPLOAD_BYTES="52428800"
